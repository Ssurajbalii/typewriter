{
  "name": "typewriter",
  "productName": "Typewriter",
  "version": "0.1.0",
  "description": "A seamless live-preview Markdown editor.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --mac --arm64",
    "dist:universal": "vite build && electron-builder --mac --universal",
    "icon": "electron scripts/make-icon.cjs",
    "dist:win": "vite build && electron-builder --win --x64",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "build": {
    "appId": "dev.typewriter.app",
    "productName": "Typewriter",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false
    },
    "dmg": {
      "title": "Typewriter ${version}",
      "artifactName": "Typewriter-${version}-${arch}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Typewriter",
      "artifactName": "Typewriter-Setup-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "katex": "^0.19.0",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0",
    "vite": "^8.3.4"
  },
  "author": {
    "name": "Suraj"
  }
}
